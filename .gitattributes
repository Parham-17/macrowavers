# Line endings: LF everywhere, Git normalises on commit.
* text=auto eol=lf
*.swift   text diff=swift
*.yml     text
*.md      text
*.strings text
*.xcstrings text
*.plist   text
*.sh      text eol=lf

# =========================
# Git LFS: binary assets
# =========================
# Anything below is stored in LFS, not in the Git history. Run `git lfs install`
# once (see the Quick start in README.md) so the filters are active on your machine.

# 3D scenes and models
*.usd   filter=lfs diff=lfs merge=lfs -text
*.usda  filter=lfs diff=lfs merge=lfs -text
*.usdc  filter=lfs diff=lfs merge=lfs -text
*.usdz  filter=lfs diff=lfs merge=lfs -text
*.reality filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.abc   filter=lfs diff=lfs merge=lfs -text
*.stl   filter=lfs diff=lfs merge=lfs -text

# Reality Composer Pro 3 project bundles: an opaque store, no text merges possible.
# One owner per scene at a time (see CONTRIBUTING.md).
**/*.realitycomposerpro/** filter=lfs diff=lfs merge=lfs -text
**/*.rkassets/** filter=lfs diff=lfs merge=lfs -text

# Textures and images
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.ktx   filter=lfs diff=lfs merge=lfs -text
*.ktx2  filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.heic  filter=lfs diff=lfs merge=lfs -text

# Audio and video
