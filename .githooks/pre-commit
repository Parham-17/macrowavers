#!/usr/bin/env bash
# 1) Large binaries must be in LFS. 2) Never commit per-user Xcode state. 3) SwiftLint staged Swift files.
set -uo pipefail
fail=0
limit=$((5 * 1024 * 1024))

while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  size=$(stat -f%z "$f")
  if [ "$size" -gt "$limit" ]; then
    attr=$(git check-attr filter -- "$f" | awk -F': ' '{print $NF}')
    if [ "$attr" != "lfs" ]; then
      echo "✗ $f is $((size / 1024 / 1024)) MB and is not tracked by Git LFS. Add its extension to .gitattributes." >&2
      fail=1
    fi
  fi
done < <(git diff --cached --name-only --diff-filter=AM -z)

if git diff --cached --name-only | grep -qE '(xcuserdata/|\.xcuserstate$)'; then
  echo "✗ Per-user Xcode state is staged. Run: git restore --staged '*xcuserdata*' '*.xcuserstate'" >&2
  fail=1
fi

if command -v swiftlint >/dev/null 2>&1; then
  swift_files=$(git diff --cached --name-only --diff-filter=AM | grep '\.swift$' || true)
  if [ -n "$swift_files" ]; then
    # shellcheck disable=SC2086
    swiftlint lint --strict --quiet $swift_files || { echo "✗ SwiftLint failed. Try: swiftlint --fix" >&2; fail=1; }
  fi
else
  echo "! swiftlint not installed; skipping lint (run brew bundle)" >&2
fi

exit $fail
